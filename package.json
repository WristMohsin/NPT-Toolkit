{
  "name": "anpt-toolkit",
  "private": true,
  "version": "0.1.0",
  "description": "ANPT Toolkit - Authorized Network Penetration Testing Toolkit",
  "author": "WristMohsin",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src tests",
    "preview": "vite preview",
    "test": "vitest",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:1420 && electron .\"",
    "electron:build": "npm run build && electron-builder --win --x64",
    "electron:build:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.0.0",
    "electron": "22.3.27",
    "electron-builder": "^24.13.3",
    "jsdom": "^30.1.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.wristmohsin.anpt-toolkit",
    "productName": "ANPT Toolkit",
    "copyright": "Copyright © 2026 WristMohsin",
    "directories": {
      "output": "release-electron",
      "buildResources": "electron"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "ANPT-Toolkit-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ANPT Toolkit"
    },
    "portable": {
      "artifactName": "ANPT-Toolkit-${version}-portable.exe"
    }
  }
}
