{
  "name": "anpt-toolkit",
  "private": true,
  "version": "1.0.0",
  "description": "ANPT Toolkit - Authorized Network Penetration Testing Toolkit",
  "author": "WristMohsin",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "tsc -b && vite build",
    "lint": "oxlint src tests",
    "preview": "vite preview",
    "test": "vitest",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:1420 && electron .\"",
    "electron:build": "vite build && electron-builder --win --ia32",
    "electron:build:dir": "vite build && electron-builder --win --ia32 --dir"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "electron": "22.3.27",
    "electron-builder": "^24.13.3",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.wristmohsin.anpt-toolkit",
    "productName": "ANPT Toolkit",
    "copyright": "Copyright © 2026 WristMohsin",
    "directories": {
      "output": "release-electron",
      "buildResources": "electron"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["ia32"]
        },
        {
          "target": "nsis",
          "arch": ["ia32"]
        }
      ],
      "artifactName": "ANPT-Toolkit-${version}-win-ia32.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ANPT Toolkit"
    },
    "portable": {
      "artifactName": "ANPT-Toolkit-${version}-portable-ia32.exe"
    }
  }
}
